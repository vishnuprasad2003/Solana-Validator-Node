# Environment Variables for Docker/Kubernetes Deployment
# Copy this file to .env and customize

# Public IP for external access
PUBLIC_IP=

# Bootstrap validator ports
BOOTSTRAP_GOSSIP_PORT=8001
BOOTSTRAP_RPC_PORT=8899
BOOTSTRAP_RPC_WS_PORT=8900
BOOTSTRAP_METRICS_PORT=9090

# Validator 1 ports
VALIDATOR_1_GOSSIP_PORT=8002
VALIDATOR_1_RPC_PORT=8901

# Validator 2 ports
VALIDATOR_2_GOSSIP_PORT=8003
VALIDATOR_2_RPC_PORT=8903

# Number of validators for multi-node setup
NUM_VALIDATORS=2

# Docker registry (for Kubernetes)
DOCKER_REGISTRY=

# Image name and tag
IMAGE_NAME=solana-validator
IMAGE_TAG=latest
