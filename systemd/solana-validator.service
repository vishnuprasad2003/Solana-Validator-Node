[Unit]
Description=Solana Test Validator
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=%USER%
WorkingDirectory=%HOME%
Environment="PATH=%HOME%/.local/share/solana/install/active_release/bin:%HOME%/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%HOME%/start-validator.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Resource Limits (prevents affecting other services)
MemoryLimit=4G
CPUQuota=200%

# Security Settings
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

