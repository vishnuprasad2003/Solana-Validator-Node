[Unit]
Description=Solana Validator - %NODE_NAME%
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=%USER%
Group=%USER%
WorkingDirectory=%WORKSPACE_ROOT%
Environment="RUST_LOG=%LOG_LEVEL%"
Environment="RUST_BACKTRACE=1"
ExecStart=%WORKSPACE_ROOT%/scripts/start-validator.sh %NODE_NAME%
ExecStop=%WORKSPACE_ROOT%/scripts/stop-validator.sh %NODE_NAME%
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=solana-validator-%NODE_NAME%

# Resource limits
LimitNOFILE=1000000
LimitNPROC=32768

# Security settings
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=%WORKSPACE_ROOT%/data %WORKSPACE_ROOT%/logs

[Install]
WantedBy=multi-user.target
