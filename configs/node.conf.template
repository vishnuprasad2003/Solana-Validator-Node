# Node-specific Configuration Template
# Copy this file to node.conf and customize for each validator node

# Node identification
NODE_NAME="validator-1"
NODE_ROLE="bootstrap"  # Options: bootstrap, validator

# Node-specific paths (override cluster defaults if needed)
NODE_LEDGER_DIR="${LEDGER_BASE_DIR}/${NODE_NAME}"
NODE_IDENTITY_KEY="${IDENTITY_KEY_DIR}/${NODE_NAME}-identity.json"
NODE_VOTE_KEY="${VOTE_KEY_DIR}/${NODE_NAME}-vote.json"
NODE_STAKE_KEY="${STAKE_KEY_DIR}/${NODE_NAME}-stake.json"

# Node-specific ports (auto-incremented for multi-node on same machine)
NODE_GOSSIP_PORT=${GOSSIP_PORT}
NODE_RPC_PORT=${RPC_PORT}
NODE_RPC_WEBSOCKET_PORT=${RPC_WEBSOCKET_PORT}
NODE_TPU_PORT=${TPU_PORT}
NODE_TPU_FORWARD_PORT=${TPU_FORWARD_PORT}
NODE_METRICS_PORT=${METRICS_PORT}

# Entrypoint (for non-bootstrap validators)
ENTRYPOINT_HOST="${BOOTSTRAP_VALIDATOR_IP}"
ENTRYPOINT_PORT="${BOOTSTRAP_VALIDATOR_GOSSIP_PORT}"

# Logging
NODE_LOG_FILE="${LOG_DIR}/${NODE_NAME}.log"

# Resource limits
NODE_MEMORY_LIMIT_MB=${VALIDATOR_MEMORY_LIMIT_MB}
