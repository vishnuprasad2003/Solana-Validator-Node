# Solana Production Cluster Configuration
# This file centralizes all configuration for easy maintenance and upgrades
# Modify values here before running setup scripts

# ============================================================================
# SOLANA VERSION CONFIGURATION
# ============================================================================
# Use "stable" for latest stable release, "beta" for beta, or specific version (e.g., "1.18.0")
SOLANA_VERSION="stable"

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================
# RPC Configuration
# For public access: Set to your actual IP address (will auto-detect if set to 0.0.0.0)
# For local access only: Set to 127.0.0.1
# Note: solana-test-validator requires a specific IP, not 0.0.0.0
RPC_BIND_ADDRESS="0.0.0.0"  # Will auto-detect actual IP if set to 0.0.0.0
RPC_PORT=8899

# Faucet Configuration (for local development/testing)
FAUCET_PORT=9900
ENABLE_FAUCET=false

# Gossip Port (for multi-node clusters)
GOSSIP_PORT=8001

# ============================================================================
# VALIDATOR CONFIGURATION
# ============================================================================
# Ledger storage directory
LEDGER_DIR="$HOME/solana-ledger"

# Log level: trace, debug, info, warn, error
LOG_LEVEL="info"

# Limit ledger size to prevent disk exhaustion (in GB)
LIMIT_LEDGER_SIZE=true
MAX_LEDGER_SIZE_GB=500

# Reset ledger on start (WARNING: Only for development)
RESET_ON_START=false

# ============================================================================
# CLUSTER CONFIGURATION
# ============================================================================
# Set to true for multi-node cluster setup
CLUSTER_MODE=false

# Entrypoint node (first node in cluster)
# Set to true on the first node, false on others
IS_ENTRYPOINT=false

# Entrypoint address (for non-entrypoint nodes)
ENTRYPOINT_ADDRESS=""

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Enable IP whitelist for RPC access (recommended for production)
ENABLE_RPC_WHITELIST=false

# Path to allowed IPs file (one IP per line, CIDR supported)
RPC_WHITELIST_FILE="$HOME/solana-security-config/allowed-ips.txt"

# ============================================================================
# AZURE CONFIGURATION
# ============================================================================
# Azure Network Security Group name (if using Azure NSG)
AZURE_NSG_NAME=""

# Azure Load Balancer name (if using Azure LB for RPC)
AZURE_LB_NAME=""

# Public IP address (will be auto-detected if empty)
PUBLIC_IP=""

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
BACKUP_DIR="$HOME/solana-backups"
BACKUP_RETENTION_DAYS=30

# ============================================================================
# MONITORING CONFIGURATION
# ============================================================================
# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=60

# ============================================================================
# RUST CONFIGURATION
# ============================================================================
RUST_REQUIRED_VERSION="1.70.0"

# ============================================================================
# METAPLEX CONFIGURATION
# ============================================================================
# Download Metaplex Token Metadata program
DOWNLOAD_METAPLEX_PROGRAM=true
METADATA_PROGRAM_ID="metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s"
PROGRAMS_DIR="$HOME/.local/share/solana-programs"
METADATA_PROGRAM_FILE="$PROGRAMS_DIR/mpl-token-metadata.so"

