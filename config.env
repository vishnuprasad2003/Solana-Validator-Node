# Solana Validator Node Configuration
# This file centralizes configuration for easy maintenance and upgrades

# Solana CLI Version
# Update this when upgrading to a new Solana version
# Use "stable" for latest stable, or specific version like "1.18.0"
SOLANA_VERSION="stable"

# Network Configuration
RPC_PORT=8899
FAUCET_PORT=9900
GOSSIP_PORT=8001

# Node Configuration
RPC_BIND_ADDRESS="127.0.0.1"
LEDGER_DIR="$HOME/solana-local-ledger"
LOG_LEVEL="info"

# Validator Configuration
LIMIT_LEDGER_SIZE=true
RESET_ON_START=false

# Metaplex Program Configuration
METADATA_PROGRAM_ID="metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s"
PROGRAMS_DIR="$HOME/.local/share/solana-programs"
METADATA_PROGRAM_FILE="$PROGRAMS_DIR/mpl-token-metadata.so"

# Rust Version Requirement
RUST_REQUIRED_VERSION="1.70.0"

# Anchor Version (for program development)
ANCHOR_VERSION="latest"

