# Keys and secrets
keys/**/*.json
*.json
!package.json
!package-lock.json
!kubernetes/*.json

# Logs
logs/**/*.log
logs/**/*.log.*
*.log

# Data directories
data/**/*
!data/.gitkeep

# PID files
*.pid

# Build artifacts
bin/*
!bin/.gitkeep

# Temporary files
*.tmp
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.code-workspace

# Source code (if building from source)
.agave-src/

# Node-specific configs (may contain sensitive info)
configs/*.conf
!configs/cluster.conf
!configs/node.conf.template
!configs/logrotate.conf

# Environment files
.env
.env.local
